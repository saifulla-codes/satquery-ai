# =====================================================================
# SatQuery AI — Environment & AI Provider Configuration
# SIH 2026 Problem Statement: SIH26167 (ISRO)
# =====================================================================

# Server Networking
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Active AI Vision-Language Provider
# Options:
#   - local_deterministic_geospatial_engine (100% offline, zero hallucination, default)
#   - groq_llama_3_2_vision (Sub-second cloud LLaMA 3.2 11B Vision)
#   - anthropic_claude_vision (Claude 3.5 Sonnet Vision)
#   - openai_gpt4o_vision (GPT-4o / GPT-4o-mini Vision)
#   - google_gemini_vision (Gemini 1.5 Flash Vision)
ACTIVE_LLM_PROVIDER=local_deterministic_geospatial_engine

# Remote Vision-Language Model API Keys (Leave blank for 100% offline local processing)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=100

# Benchmark Dataset Storage Roots (Optional: for benchmark evaluation adapters)
# DATASET_ROOT_BIGEARTHNET=/path/to/BigEarthNet-v1.0
# DATASET_ROOT_VRSBENCH=/path/to/VRSBench
# DATASET_ROOT_RSVQA=/path/to/RSVQA
# DATASET_ROOT_CDVQA=/path/to/CDVQA
